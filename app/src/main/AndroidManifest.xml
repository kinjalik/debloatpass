<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed on API 30+ to see which apps can open a .pkpass -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.apple.pkpass" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd-com.apple.pkpass" />
        </intent>
        <!-- To see Google Wallet's (disabled) pkpass import activity, see WalletApps -->
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ImportActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The walletunion://, walletpasses://, ... filter is generated from
                 deeplinks.gradle.kts (see app/build.gradle.kts) -->

            <!-- "Share" a link (deeplink or direct .pkpass URL) from a browser -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name=".PassProvider"
            android:authorities="${applicationId}.passes"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
