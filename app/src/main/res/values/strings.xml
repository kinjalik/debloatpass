<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">DebloatPass</string>
    <string name="hint_url" translatable="false">walletpasses://import/https://…/card.pkpass</string>
    <!-- Styled text (<b>, <i>, <a>, <annotation>): shown via getText(), which keeps the styling.
         <annotation color="ok|error"> is coloured in code from values(-night)/colors.xml, so
         the colour can differ between light and dark theme. -->
    <string name="intro_ready"><annotation color="ok"><b>All set!</b></annotation> Add your loyalty card as if you had the suggested app installed!</string>
    <string name="intro_no_wallet"><annotation color="error">No wallet app!</annotation> To use a loyalty card in the pkpass format you need an app that can accept it, for example <a href="https://github.com/SeineEloquenz/fosswallet/releases">FossWallet</a> or <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.walletnfcrel">Google Wallet</a>.</string>
    <!-- Shown instead of intro_no_wallet when Google Play services has its pkpass import disabled. -->
    <string name="intro_no_wallet_gms_disabled"><annotation color="error">No wallet app!</annotation> To use a loyalty card in the pkpass format you need an app that can accept it, for example <a href="https://github.com/SeineEloquenz/fosswallet/releases">FossWallet</a> <i>(importing into Google Wallet isn\'t available on your device for reasons Google doesn\'t tell us, possibly related to your region)</i>.</string>
    <string name="intro_paste">If you have the deeplink text (an add link like app://text), you can extract the pkpass by pasting the link.</string>
